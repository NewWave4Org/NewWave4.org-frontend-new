# Helm templates are Go templates, not YAML. Prettier's YAML parser throws a
# hard SyntaxError on `{{- if .Values.ingress.enabled -}}` and friends, so
# without this a format gate cannot pass at all. Values files are plain YAML
# and stay formatted; only templates/ is excluded.
helm/**/templates/

# Generated by semantic-release on every release. Formatting it guarantees a
# conflict on the next release commit, for no benefit.
CHANGELOG.md

# npm owns this file's shape.
package-lock.json

# Build output and test/report artifacts — none of it is committed, and
# formatting it wastes time on every run.
.next/
coverage/
test-results/
playwright-report/
.status-data/
node_modules/

# Static assets, not source.
public/
