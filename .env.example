# Copy this file to .env.local for local development (see README.md "Quick start").
# All NEXT_PUBLIC_* values are inlined into the client bundle at build time by Next.js —
# changing one requires a rebuild, not just a redeploy. See docs/known-issues.md.

# PayPal JS SDK client ID (sandbox or live, depending on environment)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEYS=

# Stripe webhook endpoint URL used by the donation flow
NEXT_PUBLIC_STRIPE_WEBHOOK_URL=

# Origin of the NewWave4 backend API (Java Spring Boot) — scheme + host (+ port) ONLY.
# No path, no trailing slash: https://api.stage.newwave4.org  or  http://localhost:8080
# Callers append their own path (the REST surface is under /api/v1/, photo upload/delete
# under /api/), so a path here would be wrong for one of them. utils/http/api-base-url.ts
# derives both bases from this; the build fails on a value in any other shape.
NEXT_PUBLIC_NEWWAVE_API_URL=

# Optional: sub-path the app is served under (see next.config.ts basePath/assetPrefix). Leave empty for root.
NEXT_PUBLIC_BASE_PATH=

# Public origin this deployment is served from, no trailing slash.
# Consumed by utils/seo.ts for canonical URLs, hreflang alternates and sitemap.xml.
# Falls back to https://new.newwave4.org when unset — correct for staging, WRONG anywhere
# else, and it fails silently: every canonical URL just points at the wrong host.
# Set this explicitly for production.
NEXT_PUBLIC_SITE_URL=
